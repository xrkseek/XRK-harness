# Copy to .env.macos (Git ignored). UTF-8; quote values that contain # or spaces.
# Paths may be absolute or relative to apps/desktop.
# XRK_DESKTOP_UNSIGNED is Windows-only — omit it on macOS.

XRK_DESKTOP_AUTO_UPDATE_ENV=test
XRK_DESKTOP_UPDATE_TEST_ORIGIN=

# Developer ID Application identity (security find-identity -v -p codesigning).
XRK_DESKTOP_MACOS_IDENTITY=

# Notarization (all three required together for notarize: true).
XRK_DESKTOP_MACOS_APPLE_ID=
XRK_DESKTOP_MACOS_APPLE_ID_PASSWORD=
XRK_DESKTOP_MACOS_TEAM_ID=

# Optional upload (not required for package:desktop produce).
# XRK_DESKTOP_UPLOAD_TEST_BUCKET=
# XRK_DESKTOP_UPLOAD_TEST_SECRET_ID=
# XRK_DESKTOP_UPLOAD_TEST_SECRET_KEY=
# XRK_DESKTOP_UPDATE_ORIGIN=
