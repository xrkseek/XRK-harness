# Copy to .env.windows (Git ignored). UTF-8; quote values that contain # or spaces.
# Paths may be absolute or relative to apps/desktop.
# SafeNet / eToken Authenticode — all four Windows fields are required for a signed build.
# Local unsigned packaging: set XRK_DESKTOP_UNSIGNED=1 (CLI also wins over this file).

# XRK_DESKTOP_UNSIGNED=1

XRK_DESKTOP_AUTO_UPDATE_ENV=test
XRK_DESKTOP_UPDATE_TEST_ORIGIN=

# Windows SDK SignTool (x64). Example (adjust kit version on this machine):
# XRK_DESKTOP_WINDOWS_SIGNTOOL=C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\signtool.exe
XRK_DESKTOP_WINDOWS_SIGNTOOL=

# Public leaf certificate (.cer) matching the token key container.
XRK_DESKTOP_WINDOWS_CER_FILE=

# SafeNet eToken Base Cryptographic Provider key container name (from token admin tools).
XRK_DESKTOP_WINDOWS_KEY_CONTAINER=

# Token PIN — never commit; kept only in this local file / CI secret store.
XRK_DESKTOP_WINDOWS_TOKEN_PIN=

# Optional upload (not required for package:desktop produce).
# XRK_DESKTOP_UPLOAD_TEST_BUCKET=
# XRK_DESKTOP_UPLOAD_TEST_SECRET_ID=
# XRK_DESKTOP_UPLOAD_TEST_SECRET_KEY=
# XRK_DESKTOP_UPLOAD_BUCKET=
# XRK_DESKTOP_UPLOAD_SECRET_ID=
# XRK_DESKTOP_UPLOAD_SECRET_KEY=
# XRK_DESKTOP_UPDATE_ORIGIN=
