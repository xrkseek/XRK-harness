{
  "name": "xrk-harness",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "check": "node ./scripts/check.mjs",
    "build": "node ./scripts/build.mjs",
    "test": "vitest run",
    "test:web": "vitest run --config vitest.web.config.ts",
    "test:kernel-coverage": "vitest run --config vitest.kernel.config.ts --coverage",

    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",

    "web:build": "pnpm --filter @xrkseek/web-frontend run build",
    "web:assemble": "node ./scripts/assemble-web-dist.mjs",
    "client:types": "node ./scripts/emit-client-types.mjs",
    "client:types:all": "node ./scripts/emit-client-types-all.mjs",
    "stub:types": "node ./scripts/emit-stub-types.mjs",
    "client:bundle": "node ./scripts/bundle-client-js.mjs",
    "xrk": "node ./apps/cli/dist/bin.js",
    "serve": "node ./apps/cli/dist/bin.js serve",
    "release:stage": "node ./scripts/stage-cli-release.mjs",
    "release": "node ./scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.8"
  }
}
