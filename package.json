{
  "name": "xrk-harness",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "check": "node ./scripts/check.mjs",
    "build": "node ./scripts/build.mjs",
    "test": "vitest run",
    "test:kernel-coverage": "vitest run --config vitest.kernel.config.ts --coverage",

    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",

    "web:ui:install": "pnpm --dir ./vendor/ui-src install",
    "web:ui:build": "pnpm --dir ./vendor/ui-src run build",
    "web:ui": "pnpm --dir ./vendor/ui-src exec dsh web",
    "web:ui:capture": "node ./scripts/capture-web-static.mjs",
    "xrk": "node ./apps/cli/dist/bin.js",
    "serve": "node ./apps/cli/dist/bin.js serve"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.8"
  }
}
