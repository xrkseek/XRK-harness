_tmp_*/
node_modules/
dist/
coverage/

# Shell / client build output (not source)
apps/web/**/dist/
packages/client/**/dist/
packages/client/**/lib/
packages/context/**/lib/
packages/stubs/**/lib/

.turbo/
*.log
.eslintcache
.env
.env.*
!.env.example
!.env.*.example
.DS_Store
__pycache__/
*.pyc
*.egg-info/
*.tsbuildinfo

# Workspace runtime — created on first serve/web; NEVER commit
.xrk/.credentials.yaml
.xrk/settings.yaml
.xrk/workspaces.json
.xrk/sessions/
.xrk/host-settings.json
.xrk/mnemon/
.xrk/tool-outputs/
# Runtime shadow-git checkpoints (auto-snapshot per turn); never commit
.xrk/checkpoints/
# Accidental cwd dump when harness home resolves to repo root
/workspaces.json

# Desktop unpackaged build / isolated development home (ADR-0008)
apps/desktop/.desktop-build/
apps/desktop/.env.windows
apps/desktop/.env.macos
# Generated brand icons (rebuilt by scripts/prepare-brand-icons.mjs)
apps/desktop/build/
# One-off CDP / DSH probes (debug only; never commit)
apps/desktop/scripts/_dsh-*.mjs
apps/desktop/scripts/cdp-*-probe.mjs

# Release staging (fat CLI)
.release/
.release-dead*/
.release-park*/
.release-old*/
apps/cli/product-web/

# Local probes / Playwright MCP dumps (never commit)
.playwright-mcp/
.tmp-*.mjs
.tmp-*/

# Ad-hoc scratch trees at the repo root (artwork / promo / side experiments;
# they carry their own README and must never leak into a release)
/.scratch-opus/
/tmp-*
/repo.json
/xrk-harness-promo.html

# extensions/: deny-by-default; only committed samples are tracked
/extensions/*
!/extensions/example-tools/
!/extensions/example-tools/**
!/extensions/example-channel/
!/extensions/example-channel/**
!/extensions/dsh-compat/
!/extensions/dsh-compat/**

session-agent-presets.json
