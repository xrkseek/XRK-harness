# LLM / tool API keys for this workspace.
# Copy to .credentials.yaml (same directory) — gitignored, never commit.
#
# Prefer Settings → Credentials in the product shell, or credentials.set via Face.
# Env vars with the same name override file values at runtime.

# Host HTTP auth (also settable via env XRK_API_KEY — not stored here by default)
# XRK_API_KEY: your-host-api-key

DEEPSEEK_API_KEY: sk-your-deepseek-key
# OPENROUTER_API_KEY: sk-or-your-key
# OPENAI_API_KEY: sk-your-openai-key
# ANTHROPIC_API_KEY: sk-ant-your-key
# GOOGLE_API_KEY: your-gemini-key

# Optional tool keys
# XRK_TAVILY_API_KEY: tvly-...
# XRK_BRAVE_SEARCH_API_KEY: BSA...
