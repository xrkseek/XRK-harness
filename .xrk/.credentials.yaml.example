# LLM / tool API keys for this workspace.
# Copy to .credentials.yaml (same directory) — gitignored, never commit.
#
# Prefer Settings → Credentials in the product shell, or credentials.set via Face.
# Env vars with the same name override file values at runtime.

# Host HTTP auth (also settable via env XRK_API_KEY — not stored here by default)
# XRK_API_KEY: your-host-api-key

DEEPSEEK_API_KEY: sk-your-deepseek-key
# OPENROUTER_API_KEY: sk-or-your-key
# OPENAI_API_KEY: sk-your-openai-key
# ANTHROPIC_API_KEY: sk-ant-your-key
# GOOGLE_API_KEY: your-gemini-key

# Optional tool keys
# XRK_TAVILY_API_KEY: tvly-...
# XRK_BRAVE_SEARCH_API_KEY: BSA...
# Image / video / voice (also settable via Settings → Credentials)
# XRK_IMAGE_GEN_OPENAI_KEY: sk-...
# XRK_IMAGE_GEN_FAL_KEY: ...
# XRK_IMAGE_GEN_XAI_KEY: ...
# XRK_IMAGE_GEN_OPENROUTER_KEY: ...
# XRK_IMAGE_GEN_DEEPINFRA_KEY: ...
# XRK_IMAGE_GEN_KREA_KEY: ...
# XRK_IMAGE_GEN_META_KEY: ...
# XRK_VIDEO_GEN_OPENAI_KEY: sk-...
# XRK_VIDEO_GEN_FAL_KEY: ...
# XRK_VIDEO_GEN_XAI_KEY: ...
# XRK_VIDEO_GEN_OPENROUTER_KEY: ...
# XRK_VIDEO_GEN_DEEPINFRA_KEY: ...
# XRK_VIDEO_ANALYZE_OPENAI_KEY: sk-...
# XRK_VOICE_OPENAI_KEY: sk-...
# Shared fallbacks also work at runtime: FAL_KEY · XAI_API_KEY · OPENAI_API_KEY
