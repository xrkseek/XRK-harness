{
  "name": "@xrkseek/client-hmr",
  "description": "Dev-only hot-reload driver for script-loaded client entries: SSE rebuilt frames â†?invalidate/prefetch â†?fiber swap through the vendored Loader entry",
  "version": "0.1.0-rc.8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xrkseek/XRK-harness.git",
    "directory": "packages/client/hmr"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "xrk": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@xrkseek/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@xrkseek/cordis-plugin-loader": "workspace:^",
    "@xrkseek/client-modules": "workspace:^",
    "@xrkseek/xrk-host-webserver": "workspace:^",
    "@xrkseek/xrk-invariants": "workspace:^",
    "@xrkseek/cordis": "workspace:^"
  },
  "devDependencies": {
    "@xrkseek/cordis-plugin-loader": "workspace:^",
    "@xrkseek/client-modules": "workspace:^",
    "@xrkseek/xrk-host-webserver": "workspace:^",
    "@xrkseek/xrk-invariants": "workspace:^",
    "@xrkseek/cordis": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "private": true
}
