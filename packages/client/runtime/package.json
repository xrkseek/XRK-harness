{
  "name": "@xrkseek/client-runtime",
  "description": "Client core services: SlotRegistry, SessionRuntime (scope tree + object layer)",
  "version": "0.1.0-rc.8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xrkseek/XRK-harness.git",
    "directory": "packages/client/runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "xrk": {
    "client": {
      "inject": [
        "@xrkseek/client-connection",
        "@xrkseek/xrk-typert-registry",
        "@xrkseek/xrk-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@xrkseek/xrk-agent": "workspace:^",
    "@xrkseek/xrk-attachment": "workspace:^",
    "@xrkseek/client-connection": "workspace:^",
    "@xrkseek/xrk-commands": "workspace:^",
    "@xrkseek/client-ui-slots": "workspace:^",
    "@xrkseek/xrk-host-apiproxy": "workspace:^",
    "@xrkseek/xrk-llm": "workspace:^",
    "@xrkseek/xrk-llm-retry": "workspace:^",
    "@xrkseek/xrk-session": "workspace:^",
    "@xrkseek/xrk-session-projection": "workspace:^",
    "@xrkseek/xrk-session-title": "workspace:^",
    "@xrkseek/xrk-tools": "workspace:^",
    "immer": "^10.1.1",
    "react": "^18.2.0",
    "zustand": "~4.4.7"
  },
  "peerDependencies": {
    "@xrkseek/cordis": "workspace:^",
    "@xrkseek/xrk-api-remotes": "workspace:^",
    "@xrkseek/xrk-invariants": "workspace:^",
    "@xrkseek/xrk-typert-protocol": "workspace:^",
    "@xrkseek/xrk-typert-registry": "workspace:^"
  },
  "devDependencies": {
    "@xrkseek/cordis": "workspace:^",
    "@xrkseek/xrk-api-remotes": "workspace:^",
    "@xrkseek/xrk-invariants": "workspace:^",
    "@xrkseek/xrk-timeout": "workspace:^",
    "@xrkseek/xrk-typert-protocol": "workspace:^",
    "@xrkseek/xrk-typert-registry": "workspace:^",
    "@types/react": "~18.3.1"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "private": true
}
