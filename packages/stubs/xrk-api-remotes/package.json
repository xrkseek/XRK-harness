{
  "name": "@xrkseek/xrk-api-remotes",
  "description": "XRK client-face re-export of Host remotes (connection contracts + inventory snapshot). Not the DSH Host remote assembly.",
  "version": "0.1.0-rc.7",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./types.d.ts",
      "default": "./types.d.ts"
    },
    "./package.json": "./package.json"
  },
  "xrk": {
    "client": {
      "inject": [
        "@xrkseek/xrk-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@xrkseek/cordis": "workspace:^",
    "@xrkseek/xrk-api-gateway": "workspace:^",
    "@xrkseek/xrk-brand": "workspace:^",
    "@xrkseek/client-connection": "workspace:^",
    "@xrkseek/xrk-commands": "workspace:^",
    "@xrkseek/xrk-goal": "workspace:^",
    "@xrkseek/xrk-llm": "workspace:^",
    "@xrkseek/xrk-message-feedback": "workspace:^",
    "@xrkseek/xrk-session": "workspace:^",
    "@xrkseek/xrk-settings": "workspace:^",
    "@xrkseek/xrk-typert-protocol": "workspace:^"
  }
}
