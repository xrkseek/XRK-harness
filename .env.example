# Host / CLI process environment (optional).
# Copy to .env in your workspace or export in shell — never commit real values.
#
# See docs/configuration.md for full reference.

# --- Production (recommended when exposing Host beyond localhost) ---
# XRK_API_KEY=your-host-api-key
# XRK_CORS_ORIGIN=https://your-app.example

# --- Development defaults (omit XRK_API_KEY = no auth on /api/*) ---
# XRK_HOST=127.0.0.1
# XRK_PORT=8787

# --- LLM (alternative to Settings UI / .xrk/.credentials.yaml) ---
# XRK_LLM_PRESET=deepseek
# DEEPSEEK_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...

# --- MCP (optional; default deny) ---
# XRK_MCP_ALLOW=1
# XRK_MCP_SERVERS=[{"serverName":"example","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/path"]}]

# --- Community plugin Host (optional sidecar / bridge; see docs/configuration.md) ---
# XRK_IM_GATEWAY_URL=https://your-im-relay.example
# XRK_IM_GATEWAY_WS_URL=wss://your-im-relay.example/ws
# XRK_IM_GATEWAY_TOKEN=your-relay-token
# XRK_MEMORY_EMBED_URL=https://your-vector-db.example
# XRK_MEMORY_EMBED_TOKEN=your-vector-token
# XRK_MEMORY_EMBED_COLLECTION=xrk-memory
# XRK_GENUI_NPM_ALLOWLIST=@scope/pkg-a,@scope/pkg-b
# XRK_TONGFLOW_PYTHON=/usr/bin/python3
# XRK_TONGFLOW_PYTHON_SCAN=/path/to/tongflow-scan.py
# XRK_TONGFLOW_PYTHON_RUNNER=/path/to/tongflow-runner.py
