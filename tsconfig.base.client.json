{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@xrkseek/cordis": ["./packages/cordis/src"],
      "@xrkseek/cosmokit": ["./packages/cosmokit/src"],
      "@xrkseek/schemastery": ["./packages/schemastery/src"],
      "@xrkseek/cordis-plugin-loader": ["./packages/cordis-loader/src"],
      "@xrkseek/cordis-plugin-include": ["./packages/cordis-include/src"],
      "@xrkseek/cordis-plugin-group": ["./packages/cordis-group/src"],
      "@xrkseek/xrk-file-reference": ["./packages/context/file-reference/src/index.ts"],
      "@xrkseek/xrk-file-reference/grammar": ["./packages/context/file-reference/src/grammar.ts"],
      "@xrkseek/xrk-file-reference/types": ["./packages/context/file-reference/src/types.ts"],
      "@xrkseek/xrk-session-reference/types": ["./packages/context/session-reference/src/types.ts"]
    }
  }
}
