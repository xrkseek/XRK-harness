# Captured product shell (DSH Web) — vendored/generated for Linguist.
# DSH keeps `apps/web/dist/` gitignored (source is TypeScript); this repo ships
# a captured shell so `serve` works without a UI rebuild. Do not count it as
# first-party JavaScript.
apps/web-static/** linguist-vendored
apps/web-static/** linguist-generated

# Tiny fixtures / helpers — do not skew the language bar.
packages/exec/lsp/tests/fixtures/** linguist-vendored
packages/exec/pty/scripts/** linguist-vendored
extensions/example-tools/plugin.mjs linguist-vendored
scripts/*.mjs linguist-vendored
eslint.config.mjs linguist-vendored
